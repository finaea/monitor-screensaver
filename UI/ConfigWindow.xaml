<Window x:Class="MonitorDim.UI.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorDim"
        Width="680" Height="820" MinWidth="560" MinHeight="520"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="6"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ===================== title bar ===================== -->
      <Grid Grid.Row="0" Background="{StaticResource Surface}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,9,0" />
          <TextBlock Text="MonitorDim" FontFamily="{StaticResource UiFont}" FontSize="12"
                     FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,1">
            <TextBlock x:Name="ElevationChip" Style="{StaticResource Mono}" Text="standard" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimise" ToolTip="Minimise" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to tray" />
        </StackPanel>
      </Grid>

      <!-- ===================== body ===================== -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,14,8">
        <StackPanel>

          <!-- status -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="STATUS" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{StaticResource Ok}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="StateText" Style="{StaticResource H1}" Text="Awake" />
              </StackPanel>

              <TextBlock x:Name="StateDetail" Style="{StaticResource Muted}" Margin="20,0,0,12"
                         Text="Waiting for the engine…" />

              <WrapPanel x:Name="ChipHost" Margin="20,0,0,0" />
            </StackPanel>
          </Border>

          <!-- displays -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Style="{StaticResource H2}" Text="DISPLAYS TO BLANK" Margin="0" />
                <Button Style="{StaticResource GhostButton}" Content="Rescan" HorizontalAlignment="Right"
                        Padding="9,3" Click="OnRescan" />
              </Grid>

              <ItemsControl x:Name="DisplayList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsManaged, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FriendlyName}" Style="{StaticResource Body}"
                                       FontWeight="SemiBold" TextWrapping="NoWrap" />
                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                    Visibility="{Binding PrimaryVisibility}">
                              <TextBlock Text="PRIMARY" Style="{StaticResource Mono}" FontSize="9" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding CoverState}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="NoDisplayHint" Style="{StaticResource Muted}" Visibility="Collapsed"
                         Text="No display selected — nothing will ever be blanked." />
            </StackPanel>
          </Border>

          <!-- overlay appearance -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="OVERLAY" />

              <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ModeBlackRadio" Style="{StaticResource Segment}"
                               GroupName="OverlayMode" Content="True black" Click="OnOverlayModeChanged" />
                  <RadioButton x:Name="ModeDimRadio" Style="{StaticResource Segment}"
                               GroupName="OverlayMode" Content="Dim" Click="OnOverlayModeChanged" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="ModeHint" Style="{StaticResource Mono}" Margin="0,0,0,12"
                         Text="Pixels emit nothing. Burn-in accrual stops completely." />

              <Grid x:Name="DimRow">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider x:Name="DimSlider" Grid.Column="0" Style="{StaticResource DimSlider}"
                        ValueChanged="OnDimChanged" />

                <TextBlock x:Name="DimEcho" Grid.Column="1" Style="{StaticResource Body}"
                           VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="86" />
              </Grid>

              <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="11,8" Margin="0,10,0,0">
                <TextBlock x:Name="DimWarning" Style="{StaticResource Mono}" Foreground="{StaticResource Warn}"
                           Text="Dim only slows burn-in. Anything below 100% still emits light." />
              </Border>
            </StackPanel>
          </Border>

          <!-- timing -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="IDLE TIMEOUT" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource GhostButton}" Content="1 min" Tag="60" Click="OnPreset" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="3 min" Tag="180" Click="OnPreset" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="5 min" Tag="300" Click="OnPreset" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="10 min" Tag="600" Click="OnPreset" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" Content="30 min" Tag="1800" Click="OnPreset" />
              </StackPanel>

              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TimeoutBox" Style="{StaticResource FieldBox}" Width="86"
                         TextChanged="OnTimeoutChanged" />
                <TextBlock Text="seconds" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock x:Name="TimeoutEcho" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- policy -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="WHAT COUNTS AS ACTIVITY" />

              <StackPanel Margin="0,0,0,14">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsEnabled="False" IsChecked="True">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Keyboard and mouse input" />
                    <TextBlock Style="{StaticResource Mono}" Text="Category 1 · GetLastInputInfo · always on" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <StackPanel Margin="0,0,0,14">
                <CheckBox x:Name="ForegroundToggle" Style="{StaticResource ToggleSwitch}" Click="OnPolicyChanged">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Window focus changes" />
                    <TextBlock Style="{StaticResource Mono}" Text="Category 1 · Windows counts these but GetLastInputInfo misses them" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <StackPanel Margin="0,0,0,14">
                <CheckBox x:Name="RequestToggle" Style="{StaticResource ToggleSwitch}" Click="OnPolicyChanged">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Apps requesting the display stay on" />
                    <TextBlock Style="{StaticResource Mono}" Text="Category 2 · ES_DISPLAY_REQUIRED · Parsec, Steam, OBS, video players" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="12,10">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="BEYOND WINDOWS BEHAVIOUR" Margin="0,0,0,8" />
                  <CheckBox x:Name="FullscreenToggle" Style="{StaticResource ToggleSwitch}" Click="OnPolicyChanged">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Body}" Text="Never blank during exclusive fullscreen" />
                      <TextBlock Style="{StaticResource Mono}" Text="Windows does not do this — protects fullscreen games from the overlay" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- requesters -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Style="{StaticResource H2}" Text="HOLDING THE DISPLAY AWAKE" Margin="0" />
                <Button Style="{StaticResource GhostButton}" Content="Refresh" HorizontalAlignment="Right"
                        Padding="9,3" Click="OnRefreshRequesters" />
              </Grid>

              <Border x:Name="ElevateBanner" Background="{StaticResource AccentSoft}" CornerRadius="8"
                      Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Style="{StaticResource Body}" Text="Names require administrator rights" />
                  <TextBlock Style="{StaticResource Mono}" Margin="0,3,0,8"
                             Text="Blanking works fine without it — only the per-app list needs elevation." />
                  <Button Style="{StaticResource PrimaryButton}" Content="Restart elevated"
                          HorizontalAlignment="Left" Click="OnElevate" />
                </StackPanel>
              </Border>

              <ItemsControl x:Name="RequesterList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="7" Padding="11,8" Margin="0,0,0,6">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ShortName}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                          <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1">
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Mono}" FontSize="9" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="RequesterEmpty" Style="{StaticResource Muted}" Text="Nothing." />
            </StackPanel>
          </Border>

          <!-- startup -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="STARTUP" />

              <StackPanel Margin="0,0,0,12">
                <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Click="OnStartupChanged">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Start with Windows" />
                    <TextBlock Style="{StaticResource Mono}" Text="Runs at logon and keeps running in the tray across sleep and restarts" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <StackPanel>
                <CheckBox x:Name="StartElevatedToggle" Style="{StaticResource ToggleSwitch}" Click="OnStartupChanged">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Start elevated (scheduled task)" />
                    <TextBlock Style="{StaticResource Mono}" Text="Needed only for the requester name list. No UAC prompt at logon." />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <TextBlock x:Name="StartupNote" Style="{StaticResource Mono}" Margin="0,10,0,0"
                         Foreground="{StaticResource Warn}" Visibility="Collapsed" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ===================== footer ===================== -->
      <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,1,0,0" Padding="18,10">
        <Grid>
          <TextBlock x:Name="FooterText" Style="{StaticResource Mono}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PauseButton" Style="{StaticResource GhostButton}" Content="Pause"
                    Click="OnPause" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Blank now" Click="OnBlankNow" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
