<!--
  The Avalonia twin of the Windows head's UI/Theme.xaml. Same palette, same sizes,
  same control shapes; only the mechanism differs (Avalonia selectors and pseudo-classes
  instead of WPF triggers).

  Two deliberate differences from Windows:
    * Fonts. There is no Segoe UI Variable / Cascadia Mono on macOS, so UI text simply
      inherits Avalonia's platform default (San Francisco) and monospace text asks for
      SF Mono with a Menlo fallback (shipped on every macOS since 10.6).
    * Stock controls (TextBox, Slider, ScrollBar) keep Fluent's templates and are
      recoloured through Fluent's own resource keys. Only the controls with no Fluent
      equivalent — the pill toggle, the segmented radio, the ghost/primary/caption
      buttons — carry hand-written templates, as they do on Windows.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- ============================ palette ============================ -->
    <SolidColorBrush x:Key="Bg"          Color="#0E0F14" />
    <SolidColorBrush x:Key="Surface"     Color="#161822" />
    <SolidColorBrush x:Key="SurfaceAlt"  Color="#1C1F2B" />
    <SolidColorBrush x:Key="SurfaceHot"  Color="#232736" />
    <SolidColorBrush x:Key="Border"      Color="#262A38" />
    <SolidColorBrush x:Key="BorderHot"   Color="#394054" />
    <SolidColorBrush x:Key="Text"        Color="#E9ECF5" />
    <SolidColorBrush x:Key="TextMuted"   Color="#8E95AB" />
    <SolidColorBrush x:Key="TextFaint"   Color="#616881" />
    <SolidColorBrush x:Key="Accent"      Color="#5B8CFF" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#1E2A47" />
    <SolidColorBrush x:Key="Ok"          Color="#3BD671" />
    <SolidColorBrush x:Key="Warn"        Color="#F0A63C" />
    <SolidColorBrush x:Key="Danger"      Color="#FF6B6B" />

    <FontFamily x:Key="MonoFont">SF Mono, Menlo, Monaco</FontFamily>

    <!-- ================= Fluent overrides: TextBox ================= -->
    <SolidColorBrush x:Key="TextControlBackground"            Color="#1C1F2B" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="#1C1F2B" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="#1C1F2B" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"     Color="#1C1F2B" />
    <SolidColorBrush x:Key="TextControlBorderBrush"            Color="#262A38" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#394054" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="#5B8CFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"    Color="#262A38" />
    <SolidColorBrush x:Key="TextControlForeground"             Color="#E9ECF5" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"  Color="#E9ECF5" />
    <SolidColorBrush x:Key="TextControlForegroundFocused"      Color="#E9ECF5" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled"     Color="#8E95AB" />
    <!-- Despite the name, Fluent binds this to TextBox.SelectionBrush — a brush, not a colour. -->
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#5B8CFF" />
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <Thickness x:Key="TextControlThemePadding">9,6</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
    <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>

    <!-- ================= Fluent overrides: Slider ================= -->
    <!-- Matches the Windows DimSlider: 6 px track, accent fill, white/accent thumb. -->
    <SolidColorBrush x:Key="SliderContainerBackground"            Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundPressed"     Color="Transparent" />
    <SolidColorBrush x:Key="SliderContainerBackgroundDisabled"    Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFill"                      Color="#232736" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver"           Color="#232736" />
    <SolidColorBrush x:Key="SliderTrackFillPressed"               Color="#232736" />
    <SolidColorBrush x:Key="SliderTrackValueFill"                 Color="#5B8CFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver"      Color="#5B8CFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed"          Color="#5B8CFF" />
    <SolidColorBrush x:Key="SliderThumbBackground"                Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed"         Color="#FFFFFF" />
    <x:Double x:Key="SliderHorizontalHeight">26</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">18</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">18</x:Double>
    <!-- These two are RowDefinition/ColumnDefinition sizes in Fluent's slider template,
         so they must be GridLength: declaring them as Double throws an InvalidCastException
         the first time a Slider is realised (i.e. the moment Dim mode is selected). -->
    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
    <GridLength x:Key="SliderPostContentMargin">0</GridLength>

    <!-- ================= Fluent overrides: ScrollBar ================= -->
    <SolidColorBrush x:Key="ScrollBarBackground"            Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarBorderBrush"           Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFill"             Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver"  Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke"           Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#3A4256" />
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor"   Color="#3A4256" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver"   Color="#4A5470" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed"       Color="#4A5470" />
    <x:Double x:Key="ScrollBarSize">9</x:Double>
  </Styles.Resources>

  <!-- ============================ text ============================ -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============================ card / chip ============================ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="Border.segmentHost">
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- A soft inset panel: the dim/video warning box and the "beyond Windows" group. -->
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ============================ toggle switch ============================ -->
  <Style Selector="CheckBox.toggle">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" ColumnDefinitions="Auto,*">
          <Border Name="Track" Grid.Column="0"
                  Width="38" Height="21" CornerRadius="11"
                  Background="{StaticResource SurfaceHot}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                  VerticalAlignment="Center">
            <Ellipse Name="Thumb" Width="15" Height="15" Fill="{StaticResource TextMuted}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
          </Border>

          <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="CheckBox.toggle:checked /template/ Border#Track">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <Style Selector="CheckBox.toggle:checked /template/ Ellipse#Thumb">
    <Setter Property="Fill" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,3,0" />
  </Style>

  <Style Selector="CheckBox.toggle:pointerover /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <Style Selector="CheckBox.toggle:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- ============================ buttons ============================ -->
  <Style Selector="Button.ghost">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd" CornerRadius="7"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SurfaceHot}" />
  </Style>

  <Style Selector="Button.ghost:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd" CornerRadius="7"
                Background="{StaticResource Accent}" BorderThickness="0"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.primary:pointerover /template/ Border#Bd">
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- window caption buttons: the mac window is custom-chromed like the Windows one -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.caption:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SurfaceHot}" />
  </Style>

  <Style Selector="Button.caption:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <Style Selector="Button.close:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>

  <Style Selector="Button.close:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============================ segmented radio ============================ -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Bd" CornerRadius="7"
                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource SurfaceHot}" />
  </Style>

  <Style Selector="RadioButton.segment:checked /template/ Border#Bd">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The Windows DimSlider thumb is a white disc with an accent centre; Fluent's is a
       plain white disc, so the thumb template is the one slider part worth replacing. -->
  <Style Selector="Slider /template/ Thumb#thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Ellipse Fill="White" />
          <Ellipse Fill="{StaticResource Accent}" Margin="5" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ============================ inputs ============================ -->
  <Style Selector="TextBox.field">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

</Styles>
